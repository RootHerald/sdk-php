{
    "name": "rootherald/rootherald",
    "description": "Root Herald server SDK for PHP — server-to-server Background-Check client for device attestation.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["attestation", "tpm", "rootherald", "security"],
    "homepage": "https://rootherald.io",
    "support": {
        "docs": "https://rootherald.io/developers/sdks/php",
        "source": "https://github.com/RootHerald/sdk-php",
        "issues": "https://github.com/RootHerald/sdk-php/issues"
    },
    "authors": [
        {
            "name": "Root Herald",
            "email": "hello@rootherald.io",
            "homepage": "https://rootherald.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Rootherald\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rootherald\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
